{
  "name": "electron-better-sqlite3-sqlcipher",
  "version": "0.2.0",
  "private": false,
  "description": "Build better-sqlite3 with SQLCipher for Electron, and open encrypted databases",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedcaseio/electron-better-sqlite3-sqlcipher.git"
  },
  "homepage": "https://github.com/seedcaseio/electron-better-sqlite3-sqlcipher#readme",
  "bugs": {
    "url": "https://github.com/seedcaseio/electron-better-sqlite3-sqlcipher/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts",
    "vendor/sqlcipher-amalgamation",
    "vendor/keys"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pack": "mkdir -p build/packages && npm pack --pack-destination build/packages",
    "test": "vitest run --config tests/vitest.config.mts",
    "postinstall": "bash ./scripts/bootstrap.sh postinstall",
    "sqlcipher:bootstrap": "bash ./scripts/bootstrap.sh",
    "sqlcipher:bootstrap:strict": "bash ./scripts/bootstrap.sh strict",
    "sqlcipher:prepare": "bash ./scripts/prepare-amalgamation.sh",
    "sqlcipher:ensure": "bash ./scripts/ensure-electron-sqlcipher.sh",
    "sqlcipher:rebuild": "bash ./scripts/rebuild-electron-sqlcipher.sh",
    "sqlcipher:check": "bash ./scripts/check-runtime.sh"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^13.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
